        if playlistOpen then -- 如果歌單開著，先關掉
            PlaylistFrame:TweenSize(UDim2.new(0, 300, 0, 0), "Out", "Quad", 0.3, true)
            PlaylistToggle:TweenPosition(UDim2.new(1, 10, 0, 5), "Out", "Quad", 0.3, true)
            PlaylistToggle.Text = "♫"
            playlistOpen = false
        end
        -- 高度變成 40，並隱藏內部元件
        MainFrame:TweenSize(UDim2.new(0, 350, 0, 40), "Out", "Quad", 0.3, true)
        MinimizeButton.Text = "+"
        isMinimized = true
        
        -- 隱藏內容元件
        InputBox.Visible = false
        PlayButton.Visible = false
        StopButton.Visible = false
        StopGameSoundButton.Visible = false 
        StatusLabel.Visible = false
    end
end)

-- 展開/收起歌單
PlaylistToggle.MouseButton1Click:Connect(function()
    if isMinimized then -- 如果在縮小狀態，強制先展開主視窗
        MainFrame:TweenSize(UDim2.new(0, 350, 0, 200), "Out", "Quad", 0.3, true)
        MinimizeButton.Text = "-"
        isMinimized = false
        
        InputBox.Visible = true
        PlayButton.Visible = true
        StopButton.Visible = true
        StopGameSoundButton.Visible = true 
        StatusLabel.Visible = true
        
        wait(0.3) -- 等待主視窗展開
    end
    
    playlistOpen = not playlistOpen
    
    if playlistOpen then
        PlaylistFrame:TweenSize(UDim2.new(0, 300, 0, 300), "Out", "Quad", 0.3, true) 
        PlaylistToggle:TweenPosition(UDim2.new(1, 10, 0, -30), "Out", "Quad", 0.3, true)
        PlaylistToggle.Text = "x"
    else
        PlaylistFrame:TweenSize(UDim2.new(0, 300, 0, 0), "Out", "Quad", 0.3, true)
        PlaylistToggle:TweenPosition(UDim2.new(1, 10, 0, 5), "Out", "Quad", 0.3, true)
        PlaylistToggle.Text = "♫"
    end
end)

