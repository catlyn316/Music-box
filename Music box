-- 狀態變量
local playlistOpen = false
local isMinimized = false
local CurrentSound = nil

-- 播放功能
local function PlayMusic(soundId)
    print("嘗試播放音樂 ID:", soundId)
    if CurrentSound then CurrentSound:Destroy() end
    
    CurrentSound = Instance.new("Sound")
    CurrentSound.Name = "CustomMusic"
    CurrentSound.SoundId = "rbxassetid://" .. soundId
    CurrentSound.Volume = 0.5
    CurrentSound.Looped = true
    CurrentSound.Parent = game:GetService("SoundService")
    
    CurrentSound:Play()
    StatusLabel.Text = "正在播放: " .. soundId
    StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
end

-- 停止功能
local function StopMusic()
    if CurrentSound then
        CurrentSound:Stop()
        CurrentSound:Destroy()
        CurrentSound = nil
        StatusLabel.Text = "已停止播放"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 150, 0)
    end
end

-- 停止遊戲中所有 Sound 實例
local function StopAllGameSounds()
    local count = 0
    -- 遍歷所有可能包含 Sound 的地方 (Workspace, PlayerGui, SoundService等)
    local containers = {workspace, game:GetService("SoundService"), game:GetService("ReplicatedStorage"), LocalPlayer}
    
    for _, container in ipairs(containers) do
        for _, sound in ipairs(container:GetDescendants()) do
            -- 排除我們自己的 CustomMusic
            if sound:IsA("Sound") and sound.Name ~= "CustomMusic" and sound.IsPlaying then
                sound:Stop()
                count = count + 1
            end
        end
    end

    StatusLabel.Text = "已停止 " .. count .. " 個遊戲音效"
    StatusLabel.TextColor3 = Color3.fromRGB(250, 180, 50)
    print("已停止 " .. count .. " 個遊戲音效")
end

